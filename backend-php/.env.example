# ロリポップの管理画面「データベース」メニューに表示される値を使う
DB_HOST=mysqlXXX.lolipop.jp
DB_NAME=LAAxxxxxxxx-wadai
DB_USER=LAAxxxxxxxx
DB_PASS=

# Discord Incoming Webhook（申請通知用。秘密情報。絶対にフロントには渡さない）
DISCORD_WEBHOOK_URL=

# 申請者IPを一方向ハッシュ化するためのソルト
SUBMISSION_IP_SALT=

# フロント（Vercel）のオリジン。複数ある場合はカンマ区切り
# 例: https://wadai.vercel.app,http://localhost:3000
CORS_ALLOWED_ORIGIN=http://localhost:3000

# 管理画面へのリンクを組み立てる際のベースURL（省略時はこのサーバー自身のホストを使う）
ADMIN_BASE_URL=https://your-domain.example.com/admin

# SSHが無いプランで管理者アカウントを作るための一時的なトークン（任意のランダム文字列）。
# 使い終わったら空にするか削除する。設定している間だけ /setup/create-admin が有効になる。
SETUP_TOKEN=
