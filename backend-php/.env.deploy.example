# deploy.sh 用のFTP設定。cp .env.deploy.example .env.deploy して値を埋める。
# このファイルはリポジトリ直下の .gitignore の `.env*` に含まれるため
# .env.deploy は自動でgit管理外になる。

# ロリポップの管理画面「FTP・SSHアカウント」に表示される値
FTP_HOST=ftp.lolipop.jp
FTP_PORT=21
FTP_USER=LAAxxxxxxxx
FTP_PASS=

# アップロード先ディレクトリ(ロリポップは通常 / がドキュメントルート直下)
FTP_REMOTE_DIR=/

# 1=FTPS(明示的TLS, --ssl-reqd) 0=平文FTP
FTP_SSL=1
